# Test room for the Windows GUI check: 4 x 5 x 3 m box, one glowing window in the far wall.
void plastic wall_mat 0 0 5 0.5 0.5 0.5 0 0
void plastic floor_mat 0 0 5 0.2 0.2 0.2 0 0
void glow window_glow 0 0 4 50 50 50 0

floor_mat polygon floor 0 0 12  0 0 0  4 0 0  4 5 0  0 5 0
wall_mat polygon ceiling 0 0 12  0 0 3  0 5 3  4 5 3  4 0 3
wall_mat polygon wall_south 0 0 12  0 0 0  0 0 3  4 0 3  4 0 0
wall_mat polygon wall_north 0 0 12  0 5 0  4 5 0  4 5 3  0 5 3
wall_mat polygon wall_west 0 0 12  0 0 0  0 5 0  0 5 3  0 0 3
wall_mat polygon wall_east 0 0 12  4 0 0  4 0 3  4 5 3  4 5 0
window_glow polygon window 0 0 12  1 4.99 1  3 4.99 1  3 4.99 2.2  1 4.99 2.2
